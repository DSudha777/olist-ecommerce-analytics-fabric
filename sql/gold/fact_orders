CREATE TABLE dbo.fact_orders
AS
SELECT
    order_id,
    customer_unique_id,
    purchase_date_key,
    order_purchase_timestamp,
    order_approved_at,
    order_delivered_carrier_date,
    order_delivered_customer_date,
    order_estimated_delivery_date,
    order_status,
    delivery_days,
    delivery_vs_estimate_days,
    delivered_on_time
FROM Olist_Lakehouse.dbo.fact_orders;
